{
  "id": "max/myzel/map_range",
  "meta": {
    "description": "Maps a value from one range to another, clamped to the target range"
  },
  "outputs": [
    "float"
  ],
  "inputs": {
    "value": {
      "type": "float",
      "value": 0.5
    },
    "from_min": {
      "type": "float",
      "value": 0,
      "hidden": true
    },
    "from_max": {
      "type": "float",
      "value": 1,
      "hidden": true
    },
    "to_min": {
      "type": "float",
      "value": 0
    },
    "to_max": {
      "type": "float",
      "value": 1
    },
    "smooth": {
      "type": "boolean",
      "value": false
    }
  }
}
