{
  "id": "max/myzel/output",
  "meta": {
    "description": "Shows a mesh, paths or a pattern"
  },
  "outputs": [],
  "inputs": {
    "field": {
      "type": "path",
      "accepts": [
        "mesh",
        "path",
        "pattern"
      ],
      "external": true
    },
    "resolution_field": {
      "type": "integer",
      "value": 64,
      "min": 16,
      "max": 256,
      "setting": "resolution.field"
    },
    "show": {
      "type": "select",
      "options": [
        "surface",
        "hyphae",
        "both"
      ],
      "value": 0,
      "description": "For paths: the surface around them, the paths as lines colored by group, or both"
    },
    "blend": {
      "type": "float",
      "value": 3,
      "min": 1.5,
      "max": 8,
      "step": 0.1,
      "hidden": true,
      "description": "For paths: how far, in their radii, neighbours join into one surface"
    },
    "cut": {
      "type": "select",
      "options": [
        "none",
        "open"
      ],
      "value": 0,
      "hidden": true,
      "description": "For paths: leaves out the front half (z > 0) to look inside"
    }
  }
}
