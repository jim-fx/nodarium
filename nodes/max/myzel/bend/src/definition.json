{
  "id": "max/myzel/bend",
  "meta": {
    "description": "Bends a field sideways, more the higher it gets. Positive amounts bend towards +x"
  },
  "outputs": [
    "field"
  ],
  "inputs": {
    "field": {
      "type": "field",
      "external": true
    },
    "amount": {
      "type": "float",
      "value": 2,
      "min": -20,
      "max": 20,
      "step": 0.1
    }
  }
}
