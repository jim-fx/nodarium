{
  "id": "max/myzel/smooth_union",
  "meta": {
    "description": "Joins two fields with a smooth seam"
  },
  "outputs": [
    "field"
  ],
  "inputs": {
    "a": {
      "type": "field",
      "external": true
    },
    "b": {
      "type": "field",
      "external": true
    },
    "smoothness": {
      "type": "float",
      "value": 0.01,
      "min": 0,
      "max": 0.1,
      "step": 0.001,
      "unit": "m"
    }
  }
}
