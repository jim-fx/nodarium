{
  "id": "max/plantarium/curve",
  "meta": {
    "description": "Shapes a value from 0 to 1 with a curve and scales the result to min and max"
  },
  "outputs": [
    "float"
  ],
  "inputs": {
    "value": {
      "type": "float",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "value": 0
    },
    "curve": {
      "type": "curve",
      "internal": true,
      "label": "",
      "value": [
        0,
        0,
        1,
        1
      ]
    },
    "min": {
      "type": "float",
      "internal": true,
      "min": 0,
      "max": 10,
      "step": 0.05,
      "value": 0
    },
    "max": {
      "type": "float",
      "internal": true,
      "min": 0,
      "max": 10,
      "step": 0.05,
      "value": 1
    }
  }
}
