{
  "id": "max/plantarium/stem",
  "meta": {
    "description": "Creates a stem"
  },
  "outputs": [
    "path"
  ],
  "inputs": {
    "origin": {
      "type": "vec3",
      "description": "The origin of the stem",
      "value": [
        0,
        0,
        0
      ],
      "external": true,
      "unit": "m"
    },
    "amount": {
      "type": "integer",
      "description": "The amount of stems to produce",
      "min": 1,
      "max": 64,
      "value": 1
    },
    "length": {
      "type": "float",
      "description": "How long the stem should be",
      "value": 5,
      "unit": "m"
    },
    "thickness": {
      "type": "float",
      "description": "How thick the stem should be",
      "value": 0.2,
      "unit": "m"
    },
    "resolution_curve": {
      "type": "integer",
      "description": "How many points along the length of the stem should be created",
      "value": 32,
      "min": 3,
      "max": 64,
      "setting": "resolution.curve"
    },
    "taper": {
      "type": "float",
      "description": "How much the thickness tapers to the tip. 1 = a cone, 0 = the thickness input alone sets the profile.",
      "hidden": true,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "value": 1
    }
  }
}
