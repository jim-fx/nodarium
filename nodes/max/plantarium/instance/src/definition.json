{
  "id": "max/plantarium/instance",
  "outputs": [
    "path"
  ],
  "inputs": {
    "plant": {
      "type": "path"
    },
    "geometry": {
      "type": "geometry",
      "accepts": ["path"],
      "description": "One geometry, or a list of them from a join node. Every instance picks one of them, at random or by its index.",
      "value": [0, 0, 0]
    },
    "amount": {
      "type": "integer"
    },
    "lowest_instance": {
      "type": "float",
      "min": 0,
      "max": 1,
      "value": 0.5,
      "hidden": true
    },
    "highest_instance": {
      "type": "float",
      "min": 0,
      "max": 1,
      "value": 1,
      "hidden": true
    },
    "rotation": {
      "type": "float",
      "min": 0,
      "max": 1,
      "value": 0.5,
      "hidden": true
    },
    "depth": {
      "type": "integer",
      "min": 1,
      "max": 10,
      "value": 1,
      "hidden": true
    },
    "size": {
      "type": "float",
      "min": 0,
      "step": 0.05,
      "value": 1
    },
    "angle": {
      "type": "float",
      "min": -90,
      "max": 90,
      "step": 1,
      "value": 0,
      "hidden": true
    },
    "seed": {
      "type": "seed"
    },
    "pick": {
      "type": "select",
      "internal": true,
      "hidden": true,
      "options": ["random", "index"],
      "value": 0,
      "description": "How every instance picks its geometry from the list: at random, or by its index."
    },
    "index": {
      "type": "float",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "value": 0,
      "description": "With pick index: 0 is the first geometry and 1 the last. Connect alpha to go through the list from the base of the path to its tip."
    },
    "bias": {
      "type": "float",
      "min": -1,
      "max": 1,
      "step": 0.05,
      "value": 0,
      "hidden": true,
      "description": "With pick random: above 0 the later geometries of the list are picked more often, below 0 the earlier ones."
    }
  }
}
