{
  "id": "max/plantarium/random",
  "outputs": [
    "float"
  ],
  "inputs": {
    "min": {
      "type": "float",
      "value": 1
    },
    "max": {
      "type": "float",
      "value": 2
    },
    "seed": {
      "type": "seed"
    },
    "uniform": {
      "type": "boolean",
