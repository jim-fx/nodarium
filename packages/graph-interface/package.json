{
  "name": "@nodarium/graph-interface",
  "version": "3.0.0",
  "license": "MIT",
  "description": "The node editor of Nodarium as a Svelte component, for any node registry",
  "type": "module",
  "types": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts"
    }
  },
  "publishConfig": {
    "registry": "https://git.max-richter.dev/api/packages/max/npm/",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/test-utils.*",
    "!dist/node/TestNodes.*"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.max-richter.dev/max/nodarium",
    "directory": "packages/graph-interface"
  },
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepack": "pnpm package",
    "test": "vitest",
    "test:unit": "vitest run --browser=false",
    "lint": "eslint .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "dprint fmt -c '../../.dprint.jsonc' .",
    "format:check": "dprint check -c '../../.dprint.jsonc' ."
  },
  "dependencies": {
    "file-saver": "^2.0.5",
    "jsondiffpatch": "^0.7.6"
  },
  "peerDependencies": {
    "@nodarium/runtime": "workspace:^",
    "@nodarium/ui": "workspace:^",
    "@threlte/core": "^8.6.1",
    "@threlte/extras": "^9.22.2",
    "svelte": "^5.0.0",
    "three": ">=0.186.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@nodarium/runtime": "workspace:^",
    "@nodarium/ui": "workspace:^",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@threlte/core": "8.6.1",
    "@threlte/extras": "9.22.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@vitest/browser-playwright": "^5.0.5",
    "dprint": "^0.64.1",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "publint": "^0.3.25",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "three": "^0.186.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0"
  }
}
