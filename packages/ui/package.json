{
  "name": "@nodarium/ui",
  "version": "0.0.8",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run package",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "format": "dprint fmt -c '../../.dprint.jsonc' .",
    "format:check": "dprint check -c '../../.dprint.jsonc' .",
    "lint": "eslint .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts"
    },
    "./app.css": "./src/lib/app.css"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "peerDependencies": {
    "svelte": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nodarium/types": "workspace:^",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/browser-playwright": "^5.0.5",
    "dprint": "^0.64.1",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "publint": "^0.3.25",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.9.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "dependencies": {
    "@iconify-json/tabler": "^1.2.42",
    "@iconify/tailwind4": "^1.2.3",
    "@nodarium/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@threlte/core": "^8.6.1",
    "@threlte/extras": "^9.22.2",
    "tailwindcss": "^4.3.3"
  }
}
