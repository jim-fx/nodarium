{
  "name": "@nodarium/app",
  "private": true,
  "version": "0.0.8",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "predev": "rm static/CHANGELOG.md && ln -s ../../CHANGELOG.md static/CHANGELOG.md",
    "build": "svelte-kit sync && vite build",
    "test:unit": "vitest --browser=false",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "format": "dprint fmt -c '../.dprint.jsonc' .",
    "format:check": "dprint check -c '../.dprint.jsonc' .",
    "lint": "eslint .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "bench": "tsx ./benchmark/index.ts",
    "render-graph": "tsx ./scripts/render-graph.ts",
    "format-graph": "tsx ./scripts/format-graph.ts"
  },
  "dependencies": {
    "@nodarium/planty": "workspace:*",
    "@nodarium/ui": "workspace:*",
    "@nodarium/utils": "workspace:*",
    "@sveltejs/kit": "^3.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@threlte/core": "8.6.1",
    "@threlte/extras": "9.22.2",
    "comlink": "^4.4.2",
    "file-saver": "^2.0.5",
    "idb": "^8.0.4",
    "jsondiffpatch": "^0.7.6",
    "micromark": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@iconify-json/tabler": "^1.2.42",
    "@iconify/tailwind4": "^1.2.3",
    "@nodarium/types": "workspace:^",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/file-saver": "^2.0.7",
    "@types/three": "^0.186.0",
    "@vitest/browser-playwright": "^5.0.5",
    "dprint": "^0.64.1",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-comlink": "^5.3.0",
    "vite-plugin-glsl": "^1.6.2",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0"
  }
}
